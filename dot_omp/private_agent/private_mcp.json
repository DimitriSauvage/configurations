{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v2/mcp",
      "auth": {
        "type": "oauth",
        "credentialId": "mcp_oauth:profile:default:https://mcp.atlassian.com/v2/mcp",
        "tokenUrl": "https://auth.atlassian.com/oauth/token",
        "resource": "https://mcp.atlassian.com/v2/mcp",
        "clientId": "lTZTgEt1S1dQTBcn6Z8XKlpoeaOtfVT3"
      }
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "gitwand": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@gitwand/mcp",
        "--cwd",
        "$PWD"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorizarion": "Bearer ${CONTEXT7_TOKEN}"
      },
      "enabled": true
    },
    "google_workspace": {
      "type": "http",
      "url": "http://localhost:8000/mcp"
    }
  }
}