[alias]
	# Add, commit and push in one command
	acp = "!f() { git add -A && git commit -m \"$@\" && git push -u origin \"$(git rev-parse --abbrev-ref HEAD)\"; }; f"
	# Uncommit the last commit but keep the changes in the working directory
	uncommit = reset --soft HEAD~
	## Commit and push in one command without adding all changes
	cp = "!f() { git commit -m \"$@\" && git push -u origin \"$(git rev-parse --abbrev-ref HEAD)\"; }; f"
	tp = "!f() { \
		tag=\"$1\"; \
		shift; \
		msg=\"\"; \
		while [ $# -gt 0 ]; do \
		case \"$1\" in \
			-m) \
			shift; \
			msg=\"$1\"; \
			;; \
		esac; \
		shift; \
		done; \
		if [ -z \"$msg\" ]; then \
		git tag \"$tag\" && git push origin \"$tag\"; \
		else \
		git tag -a \"$tag\" -m \"$msg\" && git push origin \"$tag\"; \
		fi; \
	}; f"
	sync-all = "!npx tsx ~/git-sync-all.ts --concurrency-limit=10"
	sync = "!npx tsx ~/git-sync.ts"
[core]
	editor = nano
	excludesfile = /Users/dsauvage/.gitignore
	fsmonitor = true
	untrackedCache = true
	emptyDirectories = true
	ignorecase = false
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[init]
	defaultBranch = main
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[push]
	default = simple
	autoSetupRemote = true
	followTags = true
[fetch]
	prune = true
	pruneTags = true
	all = true
[help]
	autocorrect = prompt
[commit]
	verbose = true
[rerere]
	enabled = true
	autoupdate = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[merge]
	conflictstyle = zdiff3
[pull]
	rebase = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = Dimitri SAUVAGE
	email = dsauvage@beetween.com
[credential "https://beetween.ghe.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
