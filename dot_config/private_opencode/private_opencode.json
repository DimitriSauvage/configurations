{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openrouter/~z-ai/glm-flash-latest",
  "model": "openrouter/~deepseek/deepseek-flash-latest",
  "instructions": [
    ".github/copilot-instructions.md",
    "~/.copilot/copilot-instructions.md",
    "~/AGENTS.md",
    "~/.config/opencode/AGENTS.md"
  ],
  "skills": {
    "paths": [
      ".github/**/skills/**/*.md",
      "~/.copilot/**/skills/**/*.md"
    ]
  },
  "plugin": [
    "context-mode",
    "@dietrichgebert/ponytail",
    "./plugins/caveman/plugin.js",
    "token-optimizer-opencode",
    [
      "@plannotator/opencode@latest",
      {
        "workflow": "all-agents"
      }
    ],
    "oh-my-openagent@latest"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": false
    },
    "gitwand": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@gitwand/mcp",
        "--cwd",
        "$PWD"
      ],
      "enabled": false
    }
  },
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.git/**",
      "**/dist/**",
      "**/.nuxt/**",
      "**/coverage/**",
      "**/target/**",
      "**/build/**",
      "**/out/**"
    ]
  },
  "lsp": true,
  "formatter": true,
  "share": "manual",
  "autoupdate": true,
  "experimental": {
    "disable_paste_summary": true
  },
  "provider": {
    "openrouter": {
      "models": {
        "openrouter/auto-beta": {},
        "openrouter/~deepseek/deepseek-flash-latest": {},
        "openrouter/~deepseek/deepseek-pro-latest": {},
        "openrouter/~z-ai/glm-latest": {},
        "openrouter/~z-ai/glm-flash-latest": {}
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:3b": {
          "name": "Qwen 2.5 Coder 3B (XS Tasks)"
        },
        "qwen3.5:9b-mlx": {
          "name": "Qwen 3.5 9B (SM Tasks)"
        },
        "qwen3.8:27b-mlx": {
          "name": "Qwen 3.8 27B (Big tasks)"
        }
      }
    }
  }
}