{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "profiles": {},
  // --------------------------------------------------------
  // TASK CATEGORIES (Intent-based routing)
  // --------------------------------------------------------
  "categories": {
    // High Intelligence (architecture, hard logic)
    "ultrabrain": {
      "model": "openrouter/~deepseek/deepseek-pro-latest",
      "reasoning": "max",
      "description": "Hard logic, complex architectural decisions, and heavy refactoring.",
    },
    "deep": {
      "model": "openrouter/~z-ai/glm-flash-latest",
      "reasoning": "max",
      "description": "Autonomous multi-step problem solving requiring deep analytical effort.",
    },
    "artistry": {
      "model": "openrouter/~z-ai/glm-flash-latest",
      "reasoning": "max",
      "description": "Creative problem-solving and novel architectural patterns.",
    },
    "unspecified-high": {
      "model": "openrouter/~z-ai/glm-flash-latest",
      "reasoning": "max",
      "description": "General tasks fallback requiring high effort.",
    },
    // Medium Tasks
    "visual-engineering": {
      "model": "openrouter/~deepseek/deepseek-flash-latest",
      "reasoning": "default",
      "description": "Frontend, UI/UX, styling layout logic, and animation flow.",
    },
    "writing": {
      "model": "openrouter/~deepseek/deepseek-flash-latest",
      "reasoning": "default",
      "description": "Documentation updates, technical prose, and commit logs.",
    },
    // Small Tasks
    "quick": {
      "model": "openrouter/~z-ai/glm-flash-latest",
      "reasoning": "default",
      "description": "Trivial edits, single-file fixes, and high-speed execution.",
    },
    "unspecified-low": {
      "model": "openrouter/~z-ai/glm-flash-latest",
      "reasoning": "default",
      "description": "General tasks fallback requiring low effort.",
    },
  },
  // --------------------------------------------------------
  // SPECIALIZED AGENTS
  // --------------------------------------------------------
  "agents": {
    "sisyphus": {
      "model": "openrouter/~deepseek/deepseek-flash-latest",
      "reasoning": "max",
      "description": "Main session orchestrator. Coordinates tasks, manages context, and delegates.",
    },
    "prometheus": {
      "model": "openrouter/~deepseek/deepseek-flash-latest",
      "reasoning": "max",
      "description": "Strategic planner and work plan builder.",
    },
    "plan-consultant": {
      "model": "openrouter/~z-ai/glm-latest",
      "reasoning": "max",
      "description": "Gap analyzer. Identifies ambiguities and hidden assumptions in plans.",
    },
    "plan-reviewer": {
      "model": "openrouter/~z-ai/glm-latest",
      "reasoning": "max",
      "description": "One-shot reviewer validating work plans against scope and clarity.",
    },
    "oracle": {
      "model": "openrouter/~z-ai/glm-latest",
      "reasoning": "max",
      "description": "High-level architectural guide and system design critic.",
    },
    "atlas": {
      "model": "openrouter/~deepseek/deepseek-flash-latest",
      "reasoning": "default",
      "description": "Task execution orchestrator following step-by-step plans.",
    },
    "explore": {
      "model": "openrouter/~z-ai/glm-flash-latest",
      "reasoning": "default",
      "description": "Fast codebase grep, symbol tracing, and pattern discovery.",
    },
    "librarian": {
      "model": "openrouter/~z-ai/glm-flash-latest",
      "reasoning": "default",
      "description": "External documentation and open-source codebase reference search.",
    },
    "hephaestus": {
      "model": "openrouter/~deepseek/deepseek-pro-latest",
    },
    "metis": {
      "model": "openrouter/~z-ai/glm-latest",
      "variant": "max",
    },
    "momus": {
      "model": "openrouter/~z-ai/glm-latest",
      "variant": "max",
    },
    "multimodal-looker": {
      "model": "openrouter/~z-ai/glm-flash-latest",
    },
  },
  // --------------------------------------------------------
  // HARNESS OVERRIDES: OPENCODE PLUGIN
  // --------------------------------------------------------
  "[opencode]": {
    "git_master": {
      "commit_footer": true,
      "include_co_authored_by": false,
      "git_env_prefix": "GIT_MASTER=1",
    },
    "disabled_hooks": [],
    "browser_automation_engine": {
      "provider": "playwright",
      "playwright_mcp_args": [],
    },
  },
  "_migrations": [
    "2026-08-reasoning-unification"
  ],
}