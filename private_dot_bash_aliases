# =========================
# Folders
# =========================
export DEV_FOLDER="$HOME/projects"

alias asdf="mise"
alias dev="cd $DEV_FOLDER"
alias ls="ls -la --color=auto"
alias doc="code ~/Google\ Drive/My\ Drive/Notes"
alias omp="EDITOR=nano omp"


# =========================
# Mise (ASDF) - source de vérité unique pour la gestion des versions d'outils
# =========================
eval "$(mise activate zsh)"

# =========================
# Zsh options
# =========================
setopt glob_dots # Inclure les fichiers commençant par un point dans les expansions de chemin

# =========================
# Company specific settings
# =========================
source ~/.bash_company_specific